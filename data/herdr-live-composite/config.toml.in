# Config for the live compositing capture. `@PERSISTENT_BACKGROUND@` is the only
# thing run.sh substitutes, so the two passes differ in exactly one key and the
# comparison between them is a real counterfactual rather than two loosely
# similar screenshots.
#
# `onboarding = false` matters: the setup modal covers the screen, and dismissing
# it needs kitty remote control, a listening socket and a synthetic keypress.
# Turning it off in the lab's own config removes all of that.
onboarding = false

[experimental]
allow_nested = true
kitty_graphics = true
# Pixel cards. Off, the sidebar is characters and there is nothing composited to
# look at.
sidebar_card_shapes = true
# An opaque wash in the same negative-z band as the whole-terminal scene, with a
# smaller blast radius. On in both passes: it is part of what the sidebar
# animation assertion watches, and holding it constant keeps the background the
# only variable between passes.
sidebar_particle_field = true
# The whole-terminal scene. This is the key under test.
persistent_background = @PERSISTENT_BACKGROUND@
# #77: hand pixels over as a local file (`t=f`) instead of base64 in the stream,
# and pick a raw pixel format for the detected terminal.
#
# Off here, and that is a finding rather than a preference. With it on, a real
# kitty client drew *no pixel surface at all* — no cards, no background scene —
# while every character surface rendered normally. The byte-level check next door
# only ever proves `t=f` reaches the wire; its own body says so ("payload being a
# pid-scoped file path rather than pixels"), so nothing has ever established that
# a terminal reads what that path points at.
#
# Set `LOCAL_TRANSPORT=true` to re-run the rig against it. That is the A/B that
# settles it, and this rig is the first thing able to run it.
kitty_graphics_local_transport = @LOCAL_TRANSPORT@

[ui]
sidebar_width = 42

[ui.sidebar.animation]
row_enter = "wipe"
row_enter_ms = 400
row_exit = "wipe"
row_exit_ms = 400
row_motion = "slide"
view_switch = "dissolve"
view_switch_ms = 400

[ui.sidebar.cards]
pulse = true
wash = true
wash_ms = 400
stage_hue = true

[ui.sidebar.notifications]
enabled = true
